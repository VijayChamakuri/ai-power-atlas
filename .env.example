# Free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Needed for ACS. Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# SEC EDGAR requires a contact address in the User-Agent.
SEC_CONTACT_EMAIL=

# Local Docker stack only. These values never leave the laptop.
POSTGRES_PASSWORD=atlas-local-dev
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas-local-dev
AIRFLOW_ADMIN_PASSWORD=atlas-local-dev
AIRFLOW_SECRET_KEY=atlas-local-dev

# Optional. Point a full rerun at another MinIO bucket to keep the frozen M1 snapshots unchanged.
# LAKE_BUCKET=atlas-lake
